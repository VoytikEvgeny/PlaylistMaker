<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="MainMenuButton" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:backgroundTint">@color/white</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_marginTop">@dimen/button_top</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/pm_black</item>
        <item name="android:textSize">@dimen/text_size</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/icon_padding</item>
        <item name="iconTint">@color/pm_black</item>
    </style>

    <style name="title">
        <item name="fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="LinearLayoutSetting">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/item_settings_height</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingHorizontal">@dimen/margin_left_right_size</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <style name="textSetting">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_setting_size</item>
        <item name="android:textFontWeight">400</item>

    </style>
    <style name="ImageSetting">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_margin">0dp</item>
        <item name="android:backgroundTint">@color/black</item>
        <item name="android:paddingRight">12dp</item>

    </style>
    <style name="background_style_main">
            <item name="android:background">@color/pm_black</item>
            <item name="android:backgroundTint">@color/pm_black</item>
    </style>

    <style name="background_style">
        <item name="android:background">@color/black</item>
        <item name="android:backgroundTint">@color/black</item>
    </style>

    <style name="ToolbarSetting">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/header_size</item>
        <item name="android:backgroundTint">@color/white</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:titleTextColor">@color/white</item>
        <item name="android:textSize">@dimen/item_settings_title_size</item>
        <item name="android:navigationIcon">@drawable/ic_back_arrow_24_light_mode</item>
    </style>

    <style name="SettingsSwitchStyle" parent = "Widget.AppCompat.CompoundButton.Switch">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="thumbTint">@color/switch_thumb_color_light</item>
        <item name="trackTint">@color/switch_track_color_light</item>
        <item name="thumbRadius">10dp</item>
        <item name="trackHeight">14dp</item>
    </style>
    <style name="edit_text_style">
        <item name="android:backgroundTint">@color/pm_light_gray</item>
        <item name="android:drawableTint">@color/pm_gray</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textColorHint">@color/pm_gray</item>
        <item name="android:background">@color/white</item>
    </style>

</resources>