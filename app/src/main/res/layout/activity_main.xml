<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/padding_main"
    android:theme="@style/Theme.PlaylistMaker"
    style="@style/background_style_main"
    tools:context=".MainActivity"
    >


    <TextView
        style="@style/title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_size"
        android:paddingLeft="@dimen/padding_main"
        android:text="@string/app_name"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingLeft="@dimen/padding_main"
        android:paddingTop="@dimen/padding_setting"
        android:paddingRight="@dimen/padding_main"
        android:paddingBottom="@dimen/padding_main_buttom">

        <Button
            android:id="@+id/search"
            style="@style/MainMenuButton"
            android:layout_marginTop="@dimen/padding_setting"
            android:text="@string/search_name"
            app:icon="@drawable/ic_search_24"
            />


        <Button
            android:id="@+id/library"
            style="@style/MainMenuButton"
            android:text="@string/library_name"
            app:icon="@drawable/ic_library_24"
            />

        <Button
            android:id="@+id/settings"
            style="@style/MainMenuButton"
            android:text="@string/settings_name"
            app:icon="@drawable/ic_settings_24"
            />

    </LinearLayout>

</LinearLayout>